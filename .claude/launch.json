{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "medicub",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "medicub-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "server"
      ],
      "port": 8787
    },
    {
      "name": "medicub-local",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5174"
      ],
      "env": {
        "MEDICUB_API": "http://localhost:8787"
      },
      "port": 5174
    }
  ]
}