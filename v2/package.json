{
  "name": "medicub-v2",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:patient": "vite build --outDir ../dist-patient --mode patient",
