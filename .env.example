# Optional environment variables for Medicub v2.
# Note: The application starts cleanly and runs with built-in offline clinical fallback even without a .env file.

# Server port (Docker Compose maps 3000:3000; local dev server defaults to 8788)
PORT=3000
HOST=0.0.0.0

# Optional Wispr Flow Voice Interface API key (https://platform-api.wisprflow.ai)
# Both WISPR_API_KEY and WISPR_FLOW_API_KEY are supported. When omitted, built-in fallback is used.
WISPR_API_KEY=your_wispr_flow_api_key_here

# Optional OpenAI-compatible LLM key for clinical consultation card extraction
# If using a non-OpenAI provider (e.g., Gemini), also set AI_ENDPOINT and AI_MODEL.
AI_API_KEY=your_llm_api_key_here
AI_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# Optional admin key for /api/audit/verify and /api/logs endpoints
MEDICUB_ADMIN_KEY=your_admin_key_here

# SQLite database storage path
MEDICUB_DB=v2/server/data/medicub.db
